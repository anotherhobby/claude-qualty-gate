{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet --python '>=3.12' python \"${CLAUDE_PLUGIN_ROOT}/quality_gate\" --shell-before",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet --python '>=3.12' python \"${CLAUDE_PLUGIN_ROOT}/quality_gate\" --guard",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet --python '>=3.12' python \"${CLAUDE_PLUGIN_ROOT}/quality_gate\" --hook",
            "timeout": 180,
            "statusMessage": "Quality gate"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet --python '>=3.12' python \"${CLAUDE_PLUGIN_ROOT}/quality_gate\" --shell-after",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet --python '>=3.12' python \"${CLAUDE_PLUGIN_ROOT}/quality_gate\" --shell-after",
            "timeout": 300
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet --python '>=3.12' python \"${CLAUDE_PLUGIN_ROOT}/quality_gate\" --stop",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
